# Agent Crawler — Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# API Security
# =============================================================================
APP_ENV=development
# Leave empty for dev mode (no auth). Set a strong key for production.
API_KEY=
INTERNAL_SERVICE_TOKEN=
# Comma-separated allowed origins. Empty = allow all (dev).
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# =============================================================================
# LLM Providers
# =============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic   # anthropic | openai
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=4096

# =============================================================================
# MinIO (Data Lake)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=
REDIS_URL=redis://:replace_with_redis_password@localhost:6379/0

# =============================================================================
# Langfuse/Postgres Infrastructure Secrets
# =============================================================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# Crawler Settings
# =============================================================================
DEFAULT_RATE_LIMIT_RPS=2.0
DEFAULT_MAX_PAGES=100
DEFAULT_MAX_RECORDS=10000
DEFAULT_TIMEOUT_SECONDS=30
RESPECT_ROBOTS_TXT=true
PROXY_ENABLED=false

# =============================================================================
# Agent Settings
# =============================================================================
AGENT_MAX_RETRIES=3
AGENT_CODE_EXECUTION_TIMEOUT=120
AGENT_SANDBOX_BACKEND=bubblewrap
AGENT_SANDBOX_MEMORY_MB=512
AGENT_SANDBOX_CPU_SECONDS=120
AGENT_SANDBOX_MAX_PROCESSES=64
AGENT_MIN_FIELD_COMPLETENESS=0.8
AGENT_GENERATED_ARTIFACT_TTL_HOURS=24
AGENT_ALERT_WEBHOOK_URL=
CHECKPOINT_BACKEND=sqlite     # sqlite | redis-stack

# =============================================================================
# Agent Memory (6 subsystems)
# =============================================================================
# #1 Checkpointer: uses REDIS_URL above + CHECKPOINT_BACKEND
# #2 Domain Memory: remembers selectors/pagination per domain
DOMAIN_MEMORY_TTL_DAYS=7
# #3 Conversation Buffer: sliding window of reasoning across nodes
CONVERSATION_BUFFER_SIZE=10
# #4 Error Patterns: tracks failure patterns to avoid repeating mistakes
ERROR_MEMORY_TTL_DAYS=14
# #5 Knowledge Base (ChromaDB): vector store for semantic crawl matching
CHROMA_PERSIST_DIR=chroma_data
# #6 Human Feedback: expert guidance from manual reviews
HUMAN_FEEDBACK_TTL_DAYS=30

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=text              # text | json

# =============================================================================
# Service URLs (for local development — overridden by docker-compose)
# =============================================================================
CRAWLER_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002
PROCESSOR_SERVICE_URL=http://localhost:8003

# =============================================================================
# Langfuse Observability (self-hosted at localhost:3000)
# =============================================================================
# 1. Start: docker compose up langfuse-server postgres
# 2. Visit:  http://localhost:3000  → create account → create project
# 3. Go to:  Settings → API Keys → copy Public + Secret key
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
