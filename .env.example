# ==============================================================================
# Agent Crawler Data — Environment Configuration
# ==============================================================================

# --- LLM Providers ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
DEFAULT_LLM_PROVIDER=anthropic  # anthropic | openai

# --- MinIO (Data Lake) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=crawler-raw
MINIO_BUCKET_CLEAN=crawler-clean
MINIO_USE_SSL=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Proxy Rotation ---
PROXY_ENABLED=true
PROXY_LIST_PATH=configs/proxies.txt
PROXY_ROTATION_STRATEGY=round_robin  # round_robin | random | least_used

# --- Crawling Defaults ---
DEFAULT_RATE_LIMIT_RPS=2
DEFAULT_MAX_PAGES=100
DEFAULT_MAX_RECORDS=10000
DEFAULT_TIMEOUT_SECONDS=30
RESPECT_ROBOTS_TXT=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json  # json | text

# --- Agent ---
AGENT_MAX_RETRIES=3
AGENT_CODE_EXECUTION_TIMEOUT=120
